{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workmemory/queue-item.schema.json",
  "title": "WorkMemory Backfill QueueItem (v3.1.2.1-final)",
  "description": "双游标协议：committedCursorSeq 只能在 items 写入成功并持久化 chunk 提交后推进。",
  "type": "object",
  "required": ["sessionId", "state", "retryCount"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 2 },
    "sessionId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["pending", "processing", "retry_wait", "completed", "failed", "skipped"] },
    "readCursorSeq": { "type": ["integer", "null"], "description": "已读到的事件 seq" },
    "committedCursorSeq": { "type": ["integer", "null"], "description": "已提交（写入成功）的事件 seq，必须 <= readCursorSeq" },
    "currentChunkId": { "type": ["string", "null"], "description": "chunk 幂等键：sessionId:startSeq:endSeq:distillerVersion" },
    "chunksCompleted": { "type": "integer", "minimum": 0 },
    "eventsRead": { "type": "integer", "minimum": 0 },
    "retryCount": { "type": "integer", "minimum": 0 },
    "nextRetryAt": { "type": ["integer", "null"], "description": "state=retry_wait 时必填；completed 时必须为 null" },
    "lastError": { "type": ["string", "null"] },
    "createdAt": { "type": "integer" },
    "updatedAt": { "type": "integer" }
  }
}
